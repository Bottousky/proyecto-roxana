{
  "version": 2,
  "purpose": "Taxonomia CERRADA de tipos de trabajo. El orquestador no describe la tarea en prosa libre: elige un `kind` de esta lista. De ahi se derivan pipeline, etapas, rol ejecutor, capabilities necesarias y si hay review obligatorio. Si un pedido no entra en ningun kind, no se inventa uno: se abre una decision CP y se agrega aca primero.",
  "note": "Los kinds de control (CONTROL_PLANE, MEASUREMENT) no estaban en la propuesta original y son la mayoria del trabajo real de esta corrida: ARC1-003 a ARC1-008 son todos de esos dos tipos. Desde v2: los kinds de arte 2D declaran humanStep=generate, porque NINGUN modelo de OpenCode genera imagenes. Se parten en tres: spec (agente barato) -> generacion (vos) -> integracion (agente barato). Solo el paso del medio depende de la cuota de ChatGPT.",
  "kinds": {
    "CODE_FEATURE": {
      "family": "code",
      "pipeline": "code_standard",
      "stages": [
        "plan",
        "build",
        "review",
        "close"
      ],
      "role": "code-worker",
      "requiredCapabilities": [
        "code"
      ],
      "reviewRequired": true,
      "humanGate": "ifVisible",
      "maxRounds": 2,
      "gates": [
        "npm run build",
        "npm test",
        "git diff --check"
      ]
    },
    "CODE_FIX": {
      "family": "code",
      "pipeline": "code_standard",
      "stages": [
        "plan",
        "build",
        "review",
        "close"
      ],
      "role": "code-worker",
      "requiredCapabilities": [
        "code"
      ],
      "reviewRequired": true,
      "humanGate": "ifVisible",
      "maxRounds": 2,
      "gates": [
        "npm run build",
        "npm test",
        "git diff --check"
      ],
      "extraRule": "Un fix necesita un caso que falle ANTES del cambio. Sin reproduccion registrada no es un fix, es una hipotesis."
    },
    "REFACTOR_SAFE": {
      "family": "code",
      "pipeline": "code_standard",
      "stages": [
        "plan",
        "build",
        "review",
        "close"
      ],
      "role": "code-worker",
      "requiredCapabilities": [
        "code"
      ],
      "reviewRequired": true,
      "humanGate": "no",
      "maxRounds": 2,
      "gates": [
        "npm run build",
        "npm test",
        "git diff --check"
      ],
      "extraRule": "Paridad de comportamiento demostrada, no afirmada. El patron de ARC1-007 es el minimo: digest determinista igual antes y despues."
    },
    "THREEJS_SCENE": {
      "family": "code",
      "pipeline": "code_visual",
      "stages": [
        "plan",
        "build",
        "review",
        "visual-qa",
        "human-gate",
        "close"
      ],
      "role": "code-worker",
      "requiredCapabilities": [
        "code",
        "browser"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "npm run build",
        "npm test",
        "git diff --check",
        "renderer.info 1440x900 + 390x844",
        "consola sin errores"
      ],
      "extraRule": "Cierra con barrido de renderer.info sobre sus propios anclajes. Sin esa medicion no cierra (SCENE_BUDGETS.md)."
    },
    "THREEJS_INTEGRATION": {
      "family": "code",
      "pipeline": "code_visual",
      "stages": [
        "plan",
        "build",
        "review",
        "visual-qa",
        "human-gate",
        "close"
      ],
      "role": "code-worker",
      "requiredCapabilities": [
        "code",
        "browser"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "npm run build",
        "npm test",
        "npm run 3d:validate-manifests",
        "git diff --check",
        "ciclo mount -> destroy limpio"
      ]
    },
    "MEASUREMENT": {
      "family": "control",
      "pipeline": "measure",
      "stages": [
        "plan",
        "build",
        "review",
        "close"
      ],
      "role": "code-worker",
      "requiredCapabilities": [
        "code",
        "browser"
      ],
      "reviewRequired": true,
      "humanGate": "no",
      "maxRounds": 2,
      "gates": [
        "metodo reproducible documentado",
        "datos crudos en evidence/"
      ],
      "extraRule": "Lo no medido va en null y cuenta como not-run. Prohibido estimar. Una medicion cuyo metodo no se puede repetir no es evidencia."
    },
    "CONTROL_PLANE": {
      "family": "control",
      "pipeline": "control",
      "stages": [
        "plan",
        "build",
        "review",
        "human-gate",
        "close"
      ],
      "role": "orchestrator",
      "requiredCapabilities": [],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "decision CP registrada en DECISIONS.md",
        "ownership rotado en el cierre"
      ],
      "extraRule": "Congelar canon, fijar presupuesto, decidir routing. Nunca se delega a una ruta gratuita."
    },
    "IMAGE_CONCEPT": {
      "family": "art2d",
      "pipeline": "art_image_only",
      "stages": [
        "art-spec",
        "generate",
        "select",
        "review-visual",
        "human-gate",
        "manifest"
      ],
      "role": "art-generator",
      "requiredCapabilities": [
        "imagegen"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "prompt, proveedor, fecha y seleccion humana registrados",
        "manifest con origen y derechos"
      ],
      "extraRule": "Se usa DESPUES de cerrar blockout, camara y composicion (ASSET_PIPELINE.md). Antes de eso una imagen linda solo adelanta una decision que todavia no se tomo.",
      "humanStep": "generate",
      "splitRoles": {
        "spec + integracion": "art-integrator (Go, barato)",
        "generacion": "art-generator (VOS, a mano en ChatGPT/Codex)"
      }
    },
    "UI_ASSET": {
      "family": "art2d",
      "pipeline": "art_image_only",
      "stages": [
        "art-spec",
        "generate",
        "select",
        "review-visual",
        "human-gate",
        "manifest"
      ],
      "role": "art-generator",
      "requiredCapabilities": [
        "imagegen"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "legible a tamano real",
        "manifest con origen y derechos"
      ],
      "humanStep": "generate",
      "splitRoles": {
        "spec + integracion": "art-integrator (Go, barato)",
        "generacion": "art-generator (VOS, a mano en ChatGPT/Codex)"
      }
    },
    "ENVIRONMENT_PLATE": {
      "family": "art2d",
      "pipeline": "art_image_only",
      "stages": [
        "art-spec",
        "generate",
        "select",
        "review-visual",
        "human-gate",
        "manifest"
      ],
      "role": "art-generator",
      "requiredCapabilities": [
        "imagegen"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "consistente con COLOR_SCRIPT.md",
        "safe areas de SHOT_DECK.md",
        "manifest"
      ],
      "humanStep": "generate",
      "splitRoles": {
        "spec + integracion": "art-integrator (Go, barato)",
        "generacion": "art-generator (VOS, a mano en ChatGPT/Codex)"
      }
    },
    "SPRITE_BASE": {
      "family": "art2d",
      "pipeline": "art_sprite",
      "stages": [
        "art-spec",
        "concept-sheet",
        "human-gate",
        "manifest"
      ],
      "role": "art-generator",
      "requiredCapabilities": [
        "imagegen"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "cuatro direcciones aprobadas en H2",
        "silueta legible al tamano de camara real"
      ],
      "extraRule": "SIEMPRE precede a SPRITE_ANIMATION. No se piden ciclos de animacion de un personaje cuya hoja base no esta aprobada.",
      "blocks": [
        "SPRITE_ANIMATION"
      ],
      "humanStep": "generate",
      "splitRoles": {
        "spec + integracion": "art-integrator (Go, barato)",
        "generacion": "art-generator (VOS, a mano en ChatGPT/Codex)"
      }
    },
    "SPRITE_ANIMATION": {
      "family": "art2d",
      "pipeline": "art_sprite",
      "stages": [
        "art-spec",
        "key-poses",
        "human-gate",
        "frames",
        "atlas",
        "review-visual",
        "human-gate",
        "manifest"
      ],
      "role": "art-generator",
      "requiredCapabilities": [
        "imagegen"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "consistencia entre frames",
        "loop sin salto",
        "atlas con pivote y frente declarados",
        "manifest"
      ],
      "requires": [
        "SPRITE_BASE"
      ],
      "extraRule": "Una tarea = un ciclo de una direccion. `todos los sprites del juego` no es una tarea.",
      "humanStep": "generate",
      "splitRoles": {
        "spec + integracion": "art-integrator (Go, barato)",
        "generacion": "art-generator (VOS, a mano en ChatGPT/Codex)"
      }
    },
    "PROC3D_FROM_IMAGE": {
      "family": "art3d",
      "pipeline": "img2threejs",
      "stages": [
        "intake-validation",
        "quality-contract",
        "spec",
        "blockout",
        "structure",
        "form",
        "material-light",
        "verify-render",
        "human-gate",
        "manifest"
      ],
      "role": "proc3d-worker",
      "requiredCapabilities": [
        "vision",
        "code"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "forge/next.py corrido antes de cada pass",
        "screenshot comparado contra referencia por pass",
        "escala en metros, origen en suelo, pivote y frente declarados"
      ],
      "extraRule": "CORRECCION IMPORTANTE: img2threejs produce CODIGO Three.js procedural, no un GLB. No hay paso de export ni de normalizacion de malla. Quien espere un .glb de este pipeline eligio el kind equivocado."
    },
    "ASSET_3D_MODULAR": {
      "family": "art3d",
      "pipeline": "modular",
      "stages": [
        "spec",
        "blockout",
        "human-gate",
        "material-light",
        "optimize",
        "integrate",
        "measure",
        "manifest"
      ],
      "role": "code-worker",
      "requiredCapabilities": [
        "code",
        "browser"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 2,
      "gates": [
        "npm run 3d:validate-manifests",
        "escala, pivote, frente, collider, presupuesto",
        "instancing para repetidos"
      ],
      "extraRule": "Nunca una region como malla unica."
    },
    "ASSET_3D_MESHY": {
      "family": "art3d",
      "pipeline": "meshy",
      "stages": [
        "budget-approval",
        "spec",
        "generate",
        "human-gate",
        "optimize",
        "integrate",
        "manifest"
      ],
      "role": "proc3d-worker",
      "requiredCapabilities": [
        "meshy"
      ],
      "reviewRequired": true,
      "humanGate": "always",
      "maxRounds": 1,
      "blockedByDefault": true,
      "unblockRequires": [
        "meshy.approved=true",
        "balanceChecked",
        "presupuesto explicito en asset-manifest.json",
        "decision en DECISIONS.md"
      ],
      "gates": [
        "maximo 3 previews por asset",
        "aprobacion humana antes de texturizar"
      ],
      "extraRule": "Presupuesto cero vigente. La existencia de MESHY_API_KEY no es aprobacion."
    },
    "REVIEW_ONLY": {
      "family": "eval",
      "pipeline": "review",
      "stages": [
        "review"
      ],
      "role": "reviewer-tech",
      "requiredCapabilities": [],
      "reviewRequired": false,
      "humanGate": "no",
      "maxRounds": 1,
      "gates": [
        "veredicto SHIP | FIX_FIRST | RETHINK con P0/P1/P2"
      ],
      "extraRule": "El reviewer no implementa. Si encuentra algo que arreglar, lo nombra; no lo toca."
    },
    "VISUAL_QA": {
      "family": "eval",
      "pipeline": "review",
      "stages": [
        "review-visual",
        "human-gate"
      ],
      "role": "reviewer-visual",
      "requiredCapabilities": [
        "vision"
      ],
      "reviewRequired": false,
      "humanGate": "always",
      "maxRounds": 1,
      "gates": [
        "capturas 1440x900 y 390x844",
        "consola",
        "pasos de reproduccion"
      ],
      "extraRule": "Build PASS no equivale a aprobacion visual. Un frame aprobado solo por screenshot no esta aprobado: falta el contrato de recorrido."
    },
    "TECH_QA": {
      "family": "eval",
      "pipeline": "review",
      "stages": [
        "review"
      ],
      "role": "reviewer-tech",
      "requiredCapabilities": [
        "code"
      ],
      "reviewRequired": false,
      "humanGate": "no",
      "maxRounds": 1,
      "gates": [
        "npm run build",
        "npm test",
        "npm run 3d:validate-manifests",
        "git diff --check"
      ]
    }
  },
  "pipelines": {
    "code_standard": "plan read-only -> build acotado -> review independiente -> cierre",
    "code_visual": "code_standard + captura desktop/mobile + medicion + gate humano obligatorio",
    "measure": "define metodo -> mide -> guarda datos crudos -> review del metodo, no del resultado",
    "control": "propone -> congela -> decision CP -> rota ownership en el cierre",
    "art_image_only": "spec artistica -> generacion -> seleccion humana -> manifest",
    "art_sprite": "hoja base aprobada -> key poses -> frames -> atlas -> manifest",
    "img2threejs": "validacion de intake -> quality contract -> spec -> passes de sculpt con verificacion visual por pass",
    "modular": "blockout -> aprobacion de forma -> material/luz -> optimizacion -> integracion -> medicion",
    "meshy": "aprobacion de presupuesto -> generacion acotada -> aprobacion humana -> optimizacion -> integracion",
    "review": "paquete de review chico -> veredicto, sin edicion"
  },
  "states": [
    "QUEUE",
    "PLANNED",
    "IN_PROGRESS",
    "TECH_REVIEW",
    "HUMAN_REVIEW",
    "WAITING_PROVIDER",
    "BLOCKED",
    "FAILED",
    "DONE"
  ],
  "stateRules": [
    "DONE exige que TODOS los archivos declarados en `evidence` existan y no esten vacios. Esta regla nace de OI-006: dos fichas declararon DONE con evidencia inexistente y nada lo impidio.",
    "TECH_REVIEW, HUMAN_REVIEW, WAITING_PROVIDER y CONDITIONAL no son DONE.",
    "WAITING_PROVIDER se usa cuando falta una capability, no cuando el trabajo es dificil.",
    "Solo el Director cambia estados."
  ],
  "limits": {
    "maxAttempts": 2,
    "maxStepsPerPacket": 12,
    "timeboxMinutes": {
      "min": 30,
      "max": 90
    },
    "maxRoundsPerPacket": 2,
    "maxRoundsPerIssue": 4,
    "note": "Estos limites duplican intencionalmente los de tasks.json/PACKETS.md. Si divergen, manda el control plane del hito y este archivo se corrige."
  }
}
