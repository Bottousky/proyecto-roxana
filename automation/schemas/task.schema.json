{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://proyecto-roxana/automation/task.schema.json",
  "title": "Roxana Task Spec",
  "description": "Contrato de una tarea delegable. Lo valida automation/scripts/validate-task.mjs sin dependencias externas: el subconjunto de JSON Schema que se usa aca es deliberadamente chico (type, required, enum, pattern, minItems, minimum, maximum, items, additionalProperties).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "state",
    "goal",
    "requestedByUser",
    "scope",
    "acceptanceCriteria",
    "limits",
    "route",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}(-[A-Z])?$",
      "description": "TASK-023, ARC1-008 o ARC1-008-A. El sufijo de letra identifica un paquete."
    },
    "title": { "type": "string", "minLength": 8, "maxLength": 120 },
    "kind": {
      "type": "string",
      "description": "Debe existir en automation/taxonomy.json. El validador lo comprueba contra el archivo, no contra un enum copiado aca."
    },
    "state": {
      "type": "string",
      "enum": ["QUEUE", "PLANNED", "IN_PROGRESS", "TECH_REVIEW", "HUMAN_REVIEW", "WAITING_PROVIDER", "BLOCKED", "FAILED", "DONE"]
    },
    "priority": { "type": "string", "enum": ["low", "medium", "high"] },
    "project": { "type": "string" },
    "run": {
      "type": "string",
      "description": "Hito del control plane al que pertenece, p. ej. ohmdal-arc1-serial-v1. Null si la tarea es externa a un hito."
    },
    "goal": { "type": "string", "minLength": 20 },
    "requestedByUser": {
      "type": "string",
      "minLength": 1,
      "description": "El pedido original, textual. No se parafrasea: es la unica forma de auditar despues si el orquestador entendio bien."
    },
    "contextSummary": { "type": "string" },
    "dependsOn": { "type": "array", "items": { "type": "string" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mustDo", "mustNotDo", "allowedPaths"],
      "properties": {
        "mustDo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "mustNotDo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Globs derivados de ownership.json. Si el worker necesita algo fuera de esta lista, se detiene."
        },
        "protectedPaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Verificables. `que quede lindo` no es un criterio; `silueta legible a 390x844 en camara real` si."
    },
    "gates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Comandos u observaciones que deben pasar. Se completan desde taxonomy.json si se omiten."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "maxSteps", "timeboxMinutes"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 20 },
        "timeboxMinutes": { "type": "integer", "minimum": 15, "maximum": 120 },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "description": "Debe existir en automation/routing.json." },
        "surface": { "type": "string", "enum": ["codex", "opencode", "claude", "human"] },
        "model": { "type": "string", "description": "modelId literal. Debe existir en el inventario local." },
        "pool": { "type": "string" },
        "session": {
          "type": "string",
          "description": "Nombre literal de la sesion, p. ej. ARC1-008-A-BUILD. Debe coincidir con telemetry.json."
        }
      }
    },
    "reviewRequired": { "type": "boolean" },
    "reviewMode": { "type": "string", "enum": ["independent_reviewer", "human_only", "none"] },
    "humanGate": { "type": "string", "enum": ["always", "ifVisible", "no"] },
    "assetRequirements": {
      "type": "object",
      "description": "Solo para kinds de familia art2d o art3d.",
      "properties": {
        "style": { "type": "string" },
        "targetEngine": { "type": "string" },
        "usage": { "type": "string" },
        "silhouette": { "type": "string" },
        "polyBudgetHint": { "type": "string" },
        "materialStyle": { "type": "string" },
        "pivot": { "type": "string" },
        "front": { "type": "string" },
        "scaleMeters": { "type": "number" },
        "directions": { "type": "integer" },
        "frames": { "type": "integer" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "files"],
      "properties": {
        "dir": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Rutas relativas a `dir`. El validador COMPRUEBA QUE EXISTAN Y NO ESTEN VACIAS antes de aceptar state=DONE."
        }
      }
    },
    "blockedReport": {
      "type": "object",
      "description": "Obligatorio cuando state es BLOCKED o FAILED.",
      "additionalProperties": false,
      "required": ["attempted", "failed", "needsClarification"],
      "properties": {
        "attempted": { "type": "string" },
        "failed": { "type": "string" },
        "needsClarification": { "type": "string" },
        "suggestEscalation": { "type": "boolean" },
        "suggestPipelineChange": { "type": "string" }
      }
    },
    "closure": {
      "type": "object",
      "description": "Obligatorio cuando state es DONE. Simetrico de blockedReport y waitingFor: hasta CP-023 una tarea podia declararse DONE sin decir quien la cerro, cuando, ni con que veredicto — y TASK-003 se quedo en queue/ una sesion entera justamente por eso.",
      "additionalProperties": false,
      "required": ["closedOn", "closedBy", "verdict"],
      "properties": {
        "closedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "closedBy": {
          "type": "string",
          "description": "Decision CP-0NN o el Director. Nunca un ejecutor: solo el Director cambia estados (CP-002)."
        },
        "verdict": { "type": "string", "minLength": 10 },
        "limits": {
          "type": "string",
          "description": "Que NO quedo demostrado. Un PASS sin limites declarados se lee como mas amplio de lo que es."
        }
      }
    },
    "waitingFor": {
      "type": "object",
      "description": "Obligatorio cuando state es WAITING_PROVIDER.",
      "additionalProperties": false,
      "required": ["capability", "provider", "resumeWhen"],
      "properties": {
        "capability": { "type": "string" },
        "provider": { "type": "string" },
        "resumeWhen": { "type": "string" }
      }
    },
    "createdOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
