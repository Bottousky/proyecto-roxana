{
  "schemaVersion": 1,
  "orchestratorId": "mavis",
  "harness": "codex-cli",
  "enabled": false,
  "model": "gpt-5.6-luna",
  "effort": "low",
  "canonicalBranch": "main",
  "activeLoop": null,
  "activeTask": null,
  "pollMinutes": 7,
  "controlPlane": {
    "mode": "state-machine",
    "workerTtlMinutes": 90,
    "activePollSeconds": 45,
    "idlePollSeconds": 15,
    "postActionPollSeconds": 10,
    "rules": [
      "workers publish RUNNING/PASS/FAIL/ERROR runtime state",
      "WAIT is mechanical and never inferred by the model",
      "model ticks execute one bounded action and never wait on child workers",
      "repository reports and canonical Git state remain durable authority"
    ]
  },
  "orchestratorRuntime": {
    "provider": "codex",
    "model": "gpt-5.6-luna",
    "effort": "low",
    "maxConsecutiveErrors": 3,
    "maxTickMinutes": 8,
    "reason": "Cheap stable control plane; Gemini 3.8 Flash High is the primary implementation lane"
  },
  "workers": {},
  "review": {
    "harness": "codex",
    "model": "gpt-5.6-luna",
    "modelAlias": "Luna",
    "effort": "medium",
    "freshSession": true,
    "readOnly": true,
    "alternateHarness": "antigravity-cli",
    "alternateModel": "gemini-3.8-flash-high",
    "alternateEffort": "high",
    "useAlternateWhen": "candidate was built by Luna or Luna independence is otherwise compromised",
    "finalFallbackModel": "gpt-5.6-terra",
    "finalFallbackEffort": "medium"
  },
  "integration": {
    "requireCleanCanonicalWorktree": true,
    "requireIndependentReview": true,
    "requireSelfAcceptanceFalse": true,
    "preferCherryPick": true,
    "allowForcePush": false,
    "allowHardReset": false,
    "allowWorkerSelfMerge": false
  },
  "limits": {
    "maxFixesPerRepairPacket": 5,
    "maxStructuralFixesPerRepairPacket": 1,
    "maxReviewRepairCyclesPerStage": 3,
    "allowPaidSpend": false,
    "allowCanonChange": false,
    "allowEngineChange": false
  }
}
