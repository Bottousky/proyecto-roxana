{
  "name": "proyecto-roxana",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "verify": "bash scripts/verificar-hito.sh",
    "smoke:play": "node scripts/smoke-play.mjs",
    "agent:gemini:check": "node scripts/agents/run-antigravity.mjs --check",
    "agent:gemini": "node scripts/agents/run-antigravity.mjs",
    "agent:gemini:builder": "node scripts/agents/run-gemini-builder.mjs",
    "agent:gemini:plaza-context": "node scripts/agents/run-antigravity.mjs --task agent-work/tasks/gemini/ohmdal-plaza-context-audit.md --out agent-work/reports/gemini/ohmdal-plaza-context-audit.md",
    "agent:gemini:plaza-review": "node scripts/agents/run-antigravity.mjs --task agent-work/tasks/gemini/ohmdal-plaza-visual-review.md --out agent-work/reports/gemini/ohmdal-plaza-visual-review.md",
    "agent:minimax:gmi:check": "node scripts/agents/run-gmi-minimax.mjs --check",
    "agent:minimax:gmi": "node scripts/agents/run-gmi-minimax.mjs",
    "orchestrator:status": "node scripts/agents/orchestrator-status.mjs",
    "orchestrator:mavis": "node scripts/agents/run-mavis.mjs",
    "orchestrator:mavis:safe": "node scripts/agents/run-mavis.mjs --safe",
    "orchestrator:mavis:once": "node scripts/agents/run-mavis.mjs --once",
    "orchestrator:mavis:interactive": "node scripts/agents/run-mavis-interactive.mjs",
    "loop:ohmdal-plaza:validate": "node scripts/agents/validate-bounded-loop-state.mjs agent-work/loops/ohmdal-plaza/state.json",
    "loop:ohmdal-arco1:validate": "node scripts/agents/validate-bounded-loop-state.mjs agent-work/loops/ohmdal-arco1-greybox/state.json",
    "loop:ohmdal-arco1-authored:validate": "node scripts/agents/validate-bounded-loop-state.mjs agent-work/loops/ohmdal-arco1-authored-pass/state.json",
    "loop:ohmdal-arco1-player-facing:validate": "node scripts/agents/validate-bounded-loop-state.mjs agent-work/loops/ohmdal-arco1-player-facing/state.json",
    "visual:ohmdal-plaza": "node scripts/visual/capture-ohmdal-plaza.mjs",
    "visual:ohmdal-plaza:fast": "node scripts/visual/capture-ohmdal-plaza.mjs --mode fast",
    "playtest:ohmdal-golden-path": "node scripts/gameplay/playtest-ohmdal-golden-path.mjs",
    "3d:validate-manifests": "node scripts/3d/validate-asset-manifests.mjs",
    "3d:validate-hero-ref": "node scripts/3d/validate-hero-reference-pack.mjs",
    "3d:validate-blender-gauntlet": "node scripts/3d/validate-blender-gauntlet.mjs",
    "3d:asset-index": "node scripts/3d/generate-asset-index.mjs",
    "3d:validate-glb": "node scripts/3d/validate-glb.mjs",
    "3d:optimize-glb": "node scripts/3d/optimize-glb.mjs",
    "3d:report-budget": "node scripts/3d/report-runtime-budget.mjs",
    "3d:fetch-polyhaven": "node scripts/3d/fetch-polyhaven.mjs",
    "3d:inventory-pack": "node scripts/3d/inventory-vendor-pack.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/havok": "^1.3.14",
    "@types/three": "^0.185.0",
    "babylonjs": "^9.19.1",
    "phaser": "^4.1.0",
    "playcanvas": "^2.21.4",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "~5.6.3",
    "vite": "^6.3.5"
  }
}
