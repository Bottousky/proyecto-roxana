{
  "name": "ohmdal-playcanvas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "build": "vite build",
    "check": "tsc --noEmit && node --check src/world.js",
    "test": "node --test arc.test.mjs tests/*.test.js",
    "test:journey": "node scripts/playthrough.mjs",
    "export:world": "node export-scene.mjs && node scripts/bake-shore.mjs && node scripts/bake-ao.mjs && node scripts/bake-relief.mjs",
    "bake:relief": "node scripts/bake-relief.mjs",
    "bake:ao": "node scripts/bake-ao.mjs",
    "textures:hd2d": "python scripts/hd2d-textures.py",
    "bake:shore": "node scripts/bake-shore.mjs",
    "art:review": "node scripts/art-review.mjs",
    "sync:canon": "node sync-game.mjs"
  },
  "dependencies": {
    "playcanvas": "2.22.1"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  },
  "version": "0.2.0",
  "description": "Ohmdal — La Luz. Arco I completo en PlayCanvas."
}
